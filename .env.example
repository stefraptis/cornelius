# Copy to .env and fill in. Never commit .env.
# All regions must be EU (GDPR). See docs/M0.md.

# ---------- Shared ----------
APP_NAME=Cornelius
APP_ENV=development                      # development | staging | production
APP_BASE_URL=http://localhost:3000       # public URL of the web app
API_BASE_URL=http://localhost:8000       # public URL of the API

# ---------- Supabase (EU region project) ----------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=               # API and workers only; never in the frontend
SUPABASE_JWT_SECRET=                     # Settings > API > JWT secret; used by the API to verify tokens
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/cornelius   # direct Postgres connection for API, workers, and tests

# Frontend copies (public). The anon key is safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}
NEXT_PUBLIC_APP_NAME=${APP_NAME}

# ---------- Object storage: Backblaze B2 (EU Central), S3 API ----------
# Private buckets only. Switching to Cloudflare R2 later is a change of these values plus a copy.
STORAGE_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
STORAGE_REGION=eu-central-003
STORAGE_BUCKET=cornelius-videos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_TTL_SECONDS=7200         # 2 hours for HLS segments
STORAGE_MULTIPART_PART_MB=64

# ---------- Jobs and workers ----------
JOBS_POLL_INTERVAL_S=5
TRANSCODE_WORKER_CONCURRENCY=1
GPU_PROVIDER=                            # runpod | modal (M2)
GPU_REGION=EU

# ---------- Email ----------
EMAIL_PROVIDER=                          # e.g. postmark | resend (EU data residency confirmed)
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---------- Monitoring ----------
SENTRY_DSN=
LOG_LEVEL=INFO
