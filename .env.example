# Copy to .env and fill in. Never commit .env.
# All regions must be EU (GDPR). See docs/M0.md.

# ---------- Shared ----------
APP_NAME=Cornelius
# Data controller named in the legal texts (a person now, a company later).
NEXT_PUBLIC_DATA_CONTROLLER_NAME=Stefanos Raptis
NEXT_PUBLIC_DATA_CONTROLLER_EMAIL=privacy@example.org
APP_ENV=development                      # development | staging | production
APP_BASE_URL=http://localhost:3100       # public URL of the web app
API_BASE_URL=http://localhost:8100       # public URL of the API

# ---------- Supabase (EU region project) ----------
# Project Settings > API keys. New projects have a publishable key
# (sb_publishable_..., safe in the browser) and secret keys (sb_secret_...,
# server only). Older projects have the anon and service_role JWTs instead;
# both styles work.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...        # API and workers only; never in the frontend
SUPABASE_JWT_SECRET=                     # Leave empty: tokens are verified with the project's JWKS (asymmetric keys).
                                         # Fill only for a legacy project still signing with the shared HS256 secret.
# Direct Postgres connection for API, workers and tests. Supabase: Connect > Session pooler URI.
# Local development: the cluster from `make db-local`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/cornelius

# Frontend copies (public). Put these in web/.env.local too.
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}
NEXT_PUBLIC_APP_NAME=${APP_NAME}

# ---------- Object storage: Backblaze B2 (EU Central), S3 API ----------
# Private buckets only. Switching to Cloudflare R2 later is a change of these values plus a copy.
STORAGE_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
STORAGE_REGION=eu-central-003
STORAGE_BUCKET=cornelius-videos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGN_TTL_SECONDS=7200         # 2 hours for HLS segments
STORAGE_MULTIPART_PART_MB=64

# ---------- Jobs and workers ----------
JOBS_POLL_INTERVAL_S=5
TRANSCODE_WORKER_CONCURRENCY=1
GPU_PROVIDER=                            # runpod | modal (M2)
GPU_REGION=EU

# ---------- Email ----------
EMAIL_PROVIDER=                          # e.g. postmark | resend (EU data residency confirmed)
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---------- Monitoring ----------
SENTRY_DSN=
LOG_LEVEL=INFO
